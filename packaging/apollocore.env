# /etc/default/apollocore — ApolloCore MCP server runtime defaults.
#
# This file is sourced by systemd as an EnvironmentFile. Lines starting
# with '#' are ignored. Variable expansion in ExecStart is performed by
# systemd, so ${APOLLO_PORT:-8765} syntax works.
#
# Override any of these to taste. The install script copies a copy of
# this file into /etc/default/apollocore.

# ───────────── Network ─────────────
# Host/port the MCP server listens on.
# Default is 127.0.0.1 (local-only per MCP spec recommendation).
# Change to 0.0.0.0 to allow LAN access (e.g. MCP clients on other machines).
APOLLO_HOST=127.0.0.1
APOLLO_PORT=8765

# ───────────── Models (GGUF files) ─────────────
# Where to scan for *.gguf model files (Settings UI dropdown + /api/models).
APOLLO_MODELS_DIR=/opt/apollocore/models
# Embedding model — required for the query_kb / add_document tools.
APOLLO_EMBED_MODEL=/opt/apollocore/models/nomic-embed-text-v1.5.Q4_K_M.gguf
# LLM — optional. Only needed for extract_entities / rerank / hyde.
# Set to empty to disable LLM-backed tools.
APOLLO_LLM_MODEL=/opt/apollocore/models/qwen2.5-0.5b-instruct-q4_k_m.gguf

# ───────────── Resources ─────────────
# Hard memory cap for the server process. The default (2 GB) covers
# nomic-embed + qwen 0.5B simultaneously. Drop to 1G if you have only
# the embedding model; raise to 4G if you're loading a larger LLM.
APOLLO_MEMORY_MAX=2G

# ───────────── UI ─────────────
# The web UI is mounted at http://localhost:8765/ by default. Set to 0
# to serve only the JSON-RPC API (no dashboard). Restart the service
# after changing this.
APOLLO_UI=1